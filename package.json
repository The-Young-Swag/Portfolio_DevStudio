{
  "name": "portfolio_devstudio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && npm run typecheck:api && vite build --configLoader native",
    "lint": "eslint .",
    "preview": "vite preview --configLoader native",
    "db:seed": "tsx db/seed.ts",
    "test:api": "tsx --test tests/api.test.ts",
    "test:unit": "tsx --test tests/sky-state.test.ts tests/night-scheduler.test.ts tests/motion-choice.test.ts",
    "typecheck:api": "tsc --noEmit -p api/tsconfig.json",
    "dev:full": "vercel dev --local-config vercel-dev.json"
  },
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.4",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
