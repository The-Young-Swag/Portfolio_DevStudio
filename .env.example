# Copy to .env.local for local development. Never commit real values.
# Local database (libSQL file). No TURSO_AUTH_TOKEN needed for file: URLs.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Required for write endpoints (Authorization: Bearer <ADMIN_TOKEN>).
ADMIN_TOKEN=choose-a-long-random-string

# Optional: GitHub contribution log.
GITHUB_TOKEN=
GITHUB_USERNAME=
